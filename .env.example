# Chrome Web Store API credentials for `npm run deploy` (chrome-webstore-upload-cli).
# Copy to .env and fill in. .env is gitignored — these are secrets. See DEPLOY.md
# for how to obtain each value (one-time setup).
#
#   set -a; source .env; set +a   # load into the shell
#   npm run deploy                 # build + upload + publish

# The item ID from the Web Store dashboard after you create the item. If the
# manifest key was honored on first upload this equals the dev ID below.
EXTENSION_ID=oofliicdlmpffmhpnlacglocdoaehpgg

# Google Cloud OAuth client (Desktop app) with the Chrome Web Store API enabled.
CLIENT_ID=
CLIENT_SECRET=
# The refresh token from the one-time OAuth consent (DEPLOY.md step 3).
REFRESH_TOKEN=
