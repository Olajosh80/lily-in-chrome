{
  "manifest_version": 3,
  "name": "Lily in Chrome",
  "version": "1.0.0",
  "key": "",
  "description": "Lily drives your browser \u2014 your real tabs and sign-ins \u2014 from Pathvela. Any Chromium browser, no remote-debugging prompt.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "debugger",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabGroups",
    "windows",
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lily in Chrome \u2014 click to start/stop recording"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Lily: voice-type into the focused field (free, multilingual)"
    }
  },
  "options_page": "recorder/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "recorder/capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
